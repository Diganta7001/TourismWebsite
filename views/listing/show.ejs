<% layout('layouts/boilerplate') %>

<div class="container show-page">
        
    <div class="show-card">
        
        <div class="show-image-wrapper">
            <img src="<%= listingData.image.url %>" 
                 class="show-image rounded-4" 
                 alt="<%= listingData.title %>">
        </div>

        <div class="show-content">
            <h2 class="show-title"><%= listingData.title %></h2>
            <i class="show-owner">Owner: <%= listingData.owner.username %></i>
            <p class="show-description"><%= listingData.description %></p>
            <p class="show-price">&#36 <%= listingData.price.toLocaleString('en-US') %>/Night</p>
            <p class="show-location"><%= listingData.location %></p>
        </div>
        <% if (currUser && currUser._id.equals(listingData.owner._id)) { %>
        <div class="show-actions">
            <!-- FIXED ROUTE -->
            <a href="/listings/<%= listingData._id %>/edit" class="btn-edit">
                Edit
            </a>

            <a href="/listings" class="btn-back">
                Back to Listings
            </a>

            <!-- FIXED ROUTE -->
            <form method="POST" action="/listings/<%= listingData._id %>?_method=DELETE">
                <button type="submit" class="btn-delete">Delete</button>
            </form>
        </div>
        <% } else { %>
            <a href="/listings" class="btn btn-primary w-100">
                Back to Listings
            </a>
        <% } %>

    </div>
    <br>
    <div class="show-card col-8  mb-3">
        <% if(currUser) {%>
        <h3>Leave a Review</h3>
        <form method="POST" action="/listings/<%= listingData._id %>/reviews" class="needs-validation" novalidate>
            <div class="form-group">
                <label for="rating">Rating:</label>
                <input type="range" name="review[rating]" id="rating" class="form-range" min="1" max="5" required>
                <div class="invalid-feedback">Rating is required</div>
            </div>
            <div class="form-group">
                <label for="comment">Comment:</label>
                <textarea name="review[comment]" id="comment" class="form-control" rows="4" required></textarea>
                <div class="invalid-feedback">Please leave a review</div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Submit Review</button>
        </form>
        <% } %>
    </div>
        <div>
        <h3>All Reviews</h3>
        <div class="row">
            <% if (listingData.reviews.length > 0) { %>
                <% listingData.reviews.forEach(review => { %>
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h4 class="card-title ms-2"><%= review.author.username %> <i>(Author)</i></h4>
                                <h5 class="card-title ms-2">Rating: <%= review.rating %> Stars</h5>
                                <p class="card-text ms-2"><%= review.comment %></p>
                            </div>
                            <form action="/listings/<%= listingData._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mb-3">
                                <button class="btn btn-sm btn-dark ms-2">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No reviews yet.</p>
            <% } %>
        </div>
    </div>
</div>